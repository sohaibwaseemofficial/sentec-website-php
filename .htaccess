DirectoryIndex index.php index.html

# Prevent direct access to sensitive config files and logs
<FilesMatch "^\.env|ca\.pem|composer\.(json|lock)|\.log$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Block access to storage directory
<IfModule mod_rewrite.c>
    RewriteRule ^storage/ - [F,L]
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Capture the hostname while stripping any leaked port numbers (like :10000)
    RewriteCond %{HTTP_HOST} ^([^:]+)
    RewriteRule ^ - [E=CLEAN_HOST:%1]

    # Prevent Apache from leaking internal ports on directory trailing slash redirects
    DirectorySlash Off
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteCond %{REQUEST_URI} !/$
    RewriteRule ^(.*)$ https://%{ENV:CLEAN_HOST}/$1/ [R=301,L]

    RewriteBase /

    # -------------------------------------------------------------
    # 0. PROTOCOL DETECTION BEHIND PROXY (Render / Cloudflare)
    # -------------------------------------------------------------
    RewriteCond %{HTTP:X-Forwarded-Proto} =https [OR]
    RewriteCond %{HTTPS} on
    RewriteRule ^ - [E=REQ_SCHEME:https]

    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteCond %{HTTPS} off
    RewriteRule ^ - [E=REQ_SCHEME:http]

    # -------------------------------------------------------------
    # 2. CANONICAL REDIRECT: /file.php -> /file (UNIVERSAL FOR ALL PAGES)
    # Redirects any direct .php access to clean URL without internal port 10000
    # -------------------------------------------------------------
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+index\.php[\s?] [NC]
    RewriteRule ^ %{ENV:REQ_SCHEME}://%{ENV:CLEAN_HOST}/ [R=301,L]

    RewriteCond %{REQUEST_METHOD} !POST
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+(.+?)\.php[\s?] [NC]
    RewriteRule ^ %{ENV:REQ_SCHEME}://%{ENV:CLEAN_HOST}/%1 [R=301,L,NE,QSA]

    # -------------------------------------------------------------
    # 3. INVISIBLE ROUTING: /file -> file.php
    # -------------------------------------------------------------
    # Don't rewrite if the request is an existing directory
    RewriteCond %{REQUEST_FILENAME} !-d
    # Don't rewrite if the request is an existing file (e.g. .css, .js, images)
    RewriteCond %{REQUEST_FILENAME} !-f
    # Check that a matching .php file actually exists
    RewriteCond %{REQUEST_FILENAME}.php -f
    # Invisibly route to the .php file and preserve query strings
    RewriteRule ^(.+?)/?$ $1.php [L,QSA]
</IfModule>
