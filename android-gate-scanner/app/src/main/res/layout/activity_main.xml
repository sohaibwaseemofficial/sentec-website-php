<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Top App Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:background="#141A20"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvAppTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SENTEC // GATE PASS"
            android:textColor="@color/neon_green"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvStationBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="STATION: NOT PAIRED"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            android:fontFamily="monospace"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvAppTitle" />

        <!-- Mode Toggle Button (Scanner vs Master Hub) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToggleMode"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:paddingHorizontal="12dp"
            android:text="Master Hub"
            android:textColor="@color/warning_orange"
            android:textSize="11sp"
            app:strokeColor="@color/warning_orange"
            app:cornerRadius="18dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Sub-Bar: Sync Status, Mode & Active Queue Counter -->
    <LinearLayout
        android:id="@+id/statusSubBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0D1115"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="6dp"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <TextView
            android:id="@+id/tvNetworkStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="● Hotspot: 192.168.43.1"
            android:textColor="@color/neon_green"
            android:textSize="11sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/tvOutboxCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Queue: 0 pending"
            android:textColor="@color/accent_blue"
            android:textSize="11sp"
            android:fontFamily="monospace" />

    </LinearLayout>

    <!-- Main Container Frame for Layout Switching (Scanner, PIN, or Master Hub) -->
    <FrameLayout
        android:id="@+id/mainContentFrame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/statusSubBar"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- 1. SCANNER VIEW -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/viewScanner"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible">

            <!-- CameraX Preview -->
            <androidx.camera.view.PreviewView
                android:id="@+id/cameraPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Scanner Reticle Box Overlay -->
            <View
                android:id="@+id/reticleBox"
                android:layout_width="260dp"
                android:layout_height="260dp"
                android:background="@drawable/ic_launcher_background"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/tvScanInstruction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Center QR Pass in Box"
                android:textColor="@color/text_white"
                android:textSize="13sp"
                android:background="#99000000"
                android:paddingHorizontal="16dp"
                android:paddingVertical="6dp"
                app:layout_constraintTop_toBottomOf="@id/reticleBox"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="16dp" />

            <!-- Torch / Flashlight Toggle Button -->
            <ImageButton
                android:id="@+id/btnTorch"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_margin="20dp"
                android:background="@color/bg_card"
                android:tint="@color/neon_green"
                android:src="@android:drawable/ic_menu_camera"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Manual Ticket Input Button -->
            <Button
                android:id="@+id/btnManualInput"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enter Code Manually"
                android:textColor="@color/accent_blue"
                android:textSize="12sp"
                app:layout_constraintBottom_toTopOf="@id/resultBannerCard"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginBottom="12dp" />

            <!-- Attendee Inspection & Verification Bottom Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/resultBannerCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="12dp"
                android:visibility="gone"
                app:cardBackgroundColor="#12181F"
                app:strokeWidth="2dp"
                app:strokeColor="@color/neon_green"
                app:cardCornerRadius="18dp"
                app:cardElevation="10dp"
                app:layout_constraintBottom_toBottomOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Header Row: Badge & Dismiss -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tvResultStatus"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="READY TO ADMIT // VERIFY ID"
                            android:textColor="@color/neon_green"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:fontFamily="monospace" />

                        <ImageButton
                            android:id="@+id/btnCloseInspection"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@android:color/transparent"
                            app:tint="@color/text_muted"
                            android:src="@android:drawable/ic_menu_close_clear_cancel" />
                    </LinearLayout>

                    <!-- Attendee Name & Ticket -->
                    <TextView
                        android:id="@+id/tvResultAttendee"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Attendee Name"
                        android:textColor="@color/text_white"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:layout_marginTop="6dp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="2dp">

                        <TextView
                            android:id="@+id/tvResultTicket"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SOC-REG-3-1"
                            android:textColor="@color/accent_blue"
                            android:textSize="13sp"
                            android:fontFamily="monospace"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvResultCnic"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" • CNIC: 42101-xxxxxxx-x"
                            android:textColor="@color/text_muted"
                            android:textSize="12sp"
                            android:fontFamily="monospace" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvResultDetail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ruh-e-Raqs / Social Night Entry"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp" />

                    <!-- Photos Verification Row (Face Photo + ID Card) -->
                    <LinearLayout
                        android:id="@+id/layoutInspectionPhotos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="12dp">

                        <!-- Face Photo Box -->
                        <LinearLayout
                            android:id="@+id/boxFacePhoto"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:layout_marginEnd="6dp"
                            android:background="#1A222C"
                            android:padding="8dp">

                            <ImageView
                                android:id="@+id/ivFacePhoto"
                                android:layout_width="match_parent"
                                android:layout_height="110dp"
                                android:scaleType="centerCrop"
                                android:src="@android:drawable/ic_menu_myplaces"
                                app:tint="#55FFFFFF" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="FACE PHOTO 🔍"
                                android:textColor="@color/neon_green"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:fontFamily="monospace"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>

                        <!-- ID Card / CNIC Box -->
                        <LinearLayout
                            android:id="@+id/boxIdCardPhoto"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:layout_marginStart="6dp"
                            android:background="#1A222C"
                            android:padding="8dp">

                            <ImageView
                                android:id="@+id/ivIdCardPhoto"
                                android:layout_width="match_parent"
                                android:layout_height="110dp"
                                android:scaleType="centerCrop"
                                android:src="@android:drawable/ic_menu_gallery"
                                app:tint="#55FFFFFF" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ID CARD / CNIC 🔍"
                                android:textColor="@color/accent_blue"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:fontFamily="monospace"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Alert / Audit Note Box -->
                    <TextView
                        android:id="@+id/tvInspectionAlert"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#203322"
                        android:textColor="@color/neon_green"
                        android:textSize="11sp"
                        android:fontFamily="monospace"
                        android:padding="8dp"
                        android:layout_marginTop="10dp"
                        android:text="Please verify participant matches photo before admitting." />

                    <!-- Action Buttons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="12dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnGrantEntry"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="2"
                            android:text="GRANT ENTRY (CONFIRM)"
                            android:textColor="@color/bg_dark"
                            android:textStyle="bold"
                            android:textSize="13sp"
                            app:backgroundTint="@color/neon_green"
                            app:cornerRadius="26dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnRejectEntry"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:text="Close"
                            android:textColor="@color/text_muted"
                            android:textSize="12sp"
                            app:strokeColor="@color/border_glass"
                            app:cornerRadius="26dp" />
                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 2. STATION AUTH PIN / QR VIEW -->
        <LinearLayout
            android:id="@+id/viewAuthPin"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp"
            android:visibility="gone"
            android:background="@color/bg_dark">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Station Setup"
                android:textColor="@color/text_white"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enter 4-digit Station PIN or scan Admin Setup QR"
                android:textColor="@color/text_muted"
                android:textSize="13sp"
                android:gravity="center"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="24dp" />

            <EditText
                android:id="@+id/etStationPin"
                android:layout_width="220dp"
                android:layout_height="56dp"
                android:background="#161C22"
                android:textColor="@color/neon_green"
                android:textSize="28sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:gravity="center"
                android:hint="1011"
                android:textColorHint="#44FFFFFF"
                android:inputType="number"
                android:maxLength="6"
                android:layout_marginBottom="16dp" />

            <EditText
                android:id="@+id/etVolunteerName"
                android:layout_width="280dp"
                android:layout_height="48dp"
                android:background="#161C22"
                android:textColor="@color/text_white"
                android:textSize="14sp"
                android:hint="Volunteer Name (e.g. Ali)"
                android:textColorHint="#55FFFFFF"
                android:paddingHorizontal="16dp"
                android:layout_marginBottom="20dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUnlockPin"
                android:layout_width="280dp"
                android:layout_height="52dp"
                android:text="Unlock Terminal"
                android:textColor="@color/bg_dark"
                android:textStyle="bold"
                app:backgroundTint="@color/neon_green"
                app:cornerRadius="26dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Preset PINs: 1011 (Gate 1 Eng), 2011 (Gate 1 Social), 9999 (Universal)"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:gravity="center"
                android:layout_marginTop="20dp" />

        </LinearLayout>

        <!-- 3. MASTER HUB HOSTING VIEW -->
        <ScrollView
            android:id="@+id/viewMasterHub"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:background="@color/bg_dark">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Master Gate Hub Active"
                    android:textColor="@color/neon_green"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Turn on Android Mobile Hotspot. Scanner phones connect automatically."
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="16dp" />

                <!-- Server Info Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/bg_card"
                    app:strokeColor="@color/border_glass"
                    app:strokeWidth="1dp"
                    app:cardCornerRadius="14dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SERVER IP &amp; PORT"
                            android:textColor="@color/text_muted"
                            android:textSize="11sp"
                            android:fontFamily="monospace" />

                        <TextView
                            android:id="@+id/tvHubServerUrl"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="http://192.168.43.1:8080"
                            android:textColor="@color/accent_blue"
                            android:textSize="16sp"
                            android:fontFamily="monospace"
                            android:textStyle="bold"
                            android:layout_marginTop="2dp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Stats Grid -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        app:cardBackgroundColor="@color/bg_card"
                        app:strokeColor="@color/border_glass"
                        app:strokeWidth="1dp"
                        app:cardCornerRadius="14dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="TOTAL ADMITTED"
                                android:textColor="@color/text_muted"
                                android:textSize="10sp"
                                android:fontFamily="monospace" />

                            <TextView
                                android:id="@+id/tvHubAdmittedCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="@color/neon_green"
                                android:textSize="24sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        app:cardBackgroundColor="@color/bg_card"
                        app:strokeColor="@color/border_glass"
                        app:strokeWidth="1dp"
                        app:cardCornerRadius="14dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="DUPLICATE ALERTS"
                                android:textColor="@color/text_muted"
                                android:textSize="10sp"
                                android:fontFamily="monospace" />

                            <TextView
                                android:id="@+id/tvHubDuplicateCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="@color/danger_red"
                                android:textSize="24sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

                <!-- Action Buttons: Pull Whitelist from Cloud, Flush to Cloud -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnHubDownloadWhitelist"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Sync Whitelist from Cloud DB"
                    android:textColor="@color/text_white"
                    app:backgroundTint="#1F2832"
                    app:cornerRadius="24dp"
                    android:layout_marginBottom="10dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnHubFlushCloud"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Upload Check-Ins to Cloud"
                    android:textColor="@color/bg_dark"
                    android:textStyle="bold"
                    app:backgroundTint="@color/neon_green"
                    app:cornerRadius="24dp" />

            </LinearLayout>
        </ScrollView>

    </FrameLayout>

    <!-- Fullscreen Image Lightbox Overlay -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/viewImageLightbox"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FA000000"
        android:visibility="gone"
        android:elevation="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvLightboxTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PARTICIPANT ID CARD"
            android:textColor="@color/neon_green"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:layout_margin="16dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <ImageButton
            android:id="@+id/btnLightboxClose"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            app:tint="@color/text_white"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:layout_margin="12dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <ImageView
            android:id="@+id/ivLightboxPhoto"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="16dp"
            android:scaleType="fitCenter"
            app:layout_constraintTop_toBottomOf="@id/tvLightboxTitle"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
